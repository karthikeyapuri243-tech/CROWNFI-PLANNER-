rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /{document=**} { allow read, write: if false; }
  function signedIn(){return request.auth != null;}
  function owns(){return signedIn() && resource.data.userId == request.auth.uid;}
  match /plannerV2Tasks/{id}{
   allow create: if signedIn() && request.resource.data.userId==request.auth.uid && request.resource.data.title is string && request.resource.data.title.size()>0 && request.resource.data.title.size()<=120;
   allow read,delete: if owns();
   allow update: if owns() && request.resource.data.userId==request.auth.uid;
  }
  match /plannerV2Habits/{id}{
   allow create: if signedIn() && request.resource.data.userId==request.auth.uid && request.resource.data.name is string && request.resource.data.name.size()>0;
   allow read,delete: if owns();
   allow update: if owns() && request.resource.data.userId==request.auth.uid;
  }
  match /plannerV2Checkins/{id}{
   allow create: if signedIn() && request.resource.data.userId==request.auth.uid && request.resource.data.habitId is string && request.resource.data.date is string;
   allow read,delete: if owns();
   allow update: if owns() && request.resource.data.userId==request.auth.uid;
  }
  match /tasks/{id}{
   allow create: if signedIn() && request.resource.data.userId==request.auth.uid && request.resource.data.title is string && request.resource.data.title.size()>=1 && request.resource.data.title.size()<=200;
   allow read,update,delete: if owns();
  }
  match /habits/{id}{
   allow create: if signedIn() && request.resource.data.userId==request.auth.uid;
   allow read,update,delete: if owns();
  }
  match /habitLogs/{id}{
   allow create: if signedIn() && request.resource.data.userId==request.auth.uid;
   allow read,update,delete: if owns();
  }
 }
}